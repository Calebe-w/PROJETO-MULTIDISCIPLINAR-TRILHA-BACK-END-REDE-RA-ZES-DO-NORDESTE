# Variaveis de ambiente - copiar este arquivo para ".env" antes de rodar.
# Windows (PowerShell): Copy-Item .env.example .env
# Linux/macOS: cp .env.example .env

# Porta onde a API sobe
PORT=3000

# Conexao com o banco (SQLite por padrao - arquivo local, zero configuracao)
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT (TROQUE em producao!)
JWT_SECRET="troque-este-segredo-em-producao-use-uma-string-longa-e-aleatoria"

# Tempo de expiracao do access token (ex.: 1h, 30m, 3600s)
JWT_EXPIRES_IN="1h"

# Tempo de expiracao do refresh token
JWT_REFRESH_EXPIRES_IN="7d"

# Ambiente: development | production | test
NODE_ENV="development"
