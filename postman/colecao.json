{
  "info": {
    "name": "API Lanchonete - Backend Multicanal",
    "_postman_id": "b1a2c3d4-0000-4000-8000-lanchonete001",
    "description": "Colecao de testes da API (fluxo critico Pedido -> Pagamento mock -> Status). Ordem sugerida: rodar a pasta Auth primeiro (captura os tokens automaticamente), depois Pedidos/Pagamento, e por fim Erros. Variavel baseUrl ja aponta para http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "clienteToken", "value": "" },
    { "key": "gerenteToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "pedidoId", "value": "" },
    { "key": "pedidoRecusaId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (novo cliente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Cliente Teste\",\n  \"email\": \"novo+{{$timestamp}}@exemplo.com\",\n  \"senha\": \"Senha@123\",\n  \"consentimentoLGPD\": true\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('status 201', () => pm.response.code === 201);",
              "pm.test('nao expoe senhaHash', () => pm.expect(pm.response.json()).to.not.have.property('senhaHash'));"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "T01 - Login valido (cliente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cliente@exemplo.com\",\n  \"senha\": \"Senha@123\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('status 200', () => pm.response.code === 200);",
              "pm.test('retorna accessToken', () => pm.expect(pm.response.json().accessToken).to.be.a('string'));",
              "pm.collectionVariables.set('clienteToken', pm.response.json().accessToken);"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "Login (gerente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"gerente@lanchonete.com\",\n  \"senha\": \"Senha@123\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.collectionVariables.set('gerenteToken', pm.response.json().accessToken);"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@lanchonete.com\",\n  \"senha\": \"Senha@123\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
            ], "type": "text/javascript" } }
          ]
        }
      ]
    },
    {
      "name": "Unidades e Produtos",
      "item": [
        {
          "name": "Listar unidades",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clienteToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/unidades", "host": ["{{baseUrl}}"], "path": ["api", "unidades"] }
          }
        },
        {
          "name": "T05 - Cardapio por unidade",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clienteToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/unidades/1/cardapio", "host": ["{{baseUrl}}"], "path": ["api", "unidades", "1", "cardapio"] }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('status 200', () => pm.response.code === 200);",
              "pm.test('lista nao vazia', () => pm.expect(pm.response.json().length).to.be.above(0));"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "Criar produto (gerente)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{gerenteToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/produtos", "host": ["{{baseUrl}}"], "path": ["api", "produtos"] },
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"X-Bacon\",\n  \"descricao\": \"Hamburguer com bacon\",\n  \"categoria\": \"LANCHE\",\n  \"preco\": 32.5\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [ "pm.test('status 201', () => pm.response.code === 201);" ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "Saldo de estoque por unidade (gerente)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{gerenteToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/estoque/unidade/1", "host": ["{{baseUrl}}"], "path": ["api", "estoque", "unidade", "1"] }
          }
        },
        {
          "name": "Movimentacao de estoque - ENTRADA (gerente)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{gerenteToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/estoque/movimentacoes", "host": ["{{baseUrl}}"], "path": ["api", "estoque", "movimentacoes"] },
            "body": { "mode": "raw", "raw": "{\n  \"unidadeId\": 1,\n  \"produtoId\": 1,\n  \"tipo\": \"ENTRADA\",\n  \"quantidade\": 20,\n  \"motivo\": \"Reposicao\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [ "pm.test('status 201', () => pm.response.code === 201);" ], "type": "text/javascript" } }
          ]
        }
      ]
    },
    {
      "name": "Pedidos e Pagamento (fluxo critico)",
      "item": [
        {
          "name": "T06 - Criar pedido (canal TOTEM)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clienteToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/pedidos", "host": ["{{baseUrl}}"], "path": ["api", "pedidos"] },
            "body": { "mode": "raw", "raw": "{\n  \"unidadeId\": 1,\n  \"canalPedido\": \"TOTEM\",\n  \"itens\": [\n    { \"produtoId\": 1, \"quantidade\": 2 },\n    { \"produtoId\": 4, \"quantidade\": 1 }\n  ]\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('status 201', () => pm.response.code === 201);",
              "pm.test('status AGUARDANDO_PAGAMENTO', () => pm.expect(pm.response.json().status).to.eql('AGUARDANDO_PAGAMENTO'));",
              "pm.collectionVariables.set('pedidoId', pm.response.json().id);"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "T10 - Pagamento mock APROVADO",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clienteToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/pagamentos", "host": ["{{baseUrl}}"], "path": ["api", "pagamentos"] },
            "body": { "mode": "raw", "raw": "{\n  \"pedidoId\": {{pedidoId}},\n  \"metodo\": \"MOCK\",\n  \"simular\": \"APROVAR\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('status 200', () => pm.response.code === 200);",
              "pm.test('pagamento APROVADO', () => pm.expect(pm.response.json().statusPagamento).to.eql('APROVADO'));",
              "pm.test('pedido PAGO', () => pm.expect(pm.response.json().statusPedido).to.eql('PAGO'));"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "Atualizar status -> EM_PREPARO (gerente)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{gerenteToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "pedidos", "{{pedidoId}}", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"EM_PREPARO\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [ "pm.test('status 200', () => pm.response.code === 200);" ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "Atualizar status -> PRONTO (gerente)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{gerenteToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "pedidos", "{{pedidoId}}", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PRONTO\"\n}" }
          }
        },
        {
          "name": "T14 - Listar pedidos por canal (TOTEM)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{gerenteToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/pedidos?canalPedido=TOTEM", "host": ["{{baseUrl}}"], "path": ["api", "pedidos"], "query": [{ "key": "canalPedido", "value": "TOTEM" }] }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('todos do canal TOTEM', () => pm.expect(pm.response.json().dados.every(p => p.canalPedido === 'TOTEM')).to.be.true);"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "Saldo de fidelidade (cliente)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clienteToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/fidelidade/saldo", "host": ["{{baseUrl}}"], "path": ["api", "fidelidade", "saldo"] }
          }
        }
      ]
    },
    {
      "name": "Erros (cenarios negativos)",
      "item": [
        {
          "name": "T02 - Acesso sem token (401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/pedidos", "host": ["{{baseUrl}}"], "path": ["api", "pedidos"] }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('status 401', () => pm.response.code === 401);",
              "pm.test('erro NAO_AUTENTICADO', () => pm.expect(pm.response.json().error).to.eql('NAO_AUTENTICADO'));"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "T03 - Cliente em rota ADMIN (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clienteToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "usuarios"] }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('status 403', () => pm.response.code === 403);",
              "pm.test('erro SEM_PERMISSAO', () => pm.expect(pm.response.json().error).to.eql('SEM_PERMISSAO'));"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "T04 - Login invalido (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cliente@exemplo.com\",\n  \"senha\": \"errada\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('status 401', () => pm.response.code === 401);",
              "pm.test('erro CREDENCIAIS_INVALIDAS', () => pm.expect(pm.response.json().error).to.eql('CREDENCIAIS_INVALIDAS'));"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "T07 - Pedido sem canalPedido (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clienteToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/pedidos", "host": ["{{baseUrl}}"], "path": ["api", "pedidos"] },
            "body": { "mode": "raw", "raw": "{\n  \"unidadeId\": 1,\n  \"itens\": [ { \"produtoId\": 1, \"quantidade\": 1 } ]\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('status 422', () => pm.response.code === 422);",
              "pm.test('erro VALIDACAO', () => pm.expect(pm.response.json().error).to.eql('VALIDACAO'));"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "T08 - Pedido com produto inexistente (404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clienteToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/pedidos", "host": ["{{baseUrl}}"], "path": ["api", "pedidos"] },
            "body": { "mode": "raw", "raw": "{\n  \"unidadeId\": 1,\n  \"canalPedido\": \"APP\",\n  \"itens\": [ { \"produtoId\": 9999, \"quantidade\": 1 } ]\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [ "pm.test('status 404', () => pm.response.code === 404);" ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "T09 - Pedido com estoque insuficiente (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clienteToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/pedidos", "host": ["{{baseUrl}}"], "path": ["api", "pedidos"] },
            "body": { "mode": "raw", "raw": "{\n  \"unidadeId\": 2,\n  \"canalPedido\": \"WEB\",\n  \"itens\": [ { \"produtoId\": 1, \"quantidade\": 999 } ]\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('status 409', () => pm.response.code === 409);",
              "pm.test('erro ESTOQUE_INSUFICIENTE', () => pm.expect(pm.response.json().error).to.eql('ESTOQUE_INSUFICIENTE'));"
            ], "type": "text/javascript" } }
          ]
        },
        {
          "name": "T11 - Pagamento mock RECUSADO",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const res = pm.sendRequest;",
              "// cria um pedido novo para recusar",
              "pm.sendRequest({",
              "  url: pm.collectionVariables.get('baseUrl') + '/api/pedidos',",
              "  method: 'POST',",
              "  header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.collectionVariables.get('clienteToken') },",
              "  body: { mode: 'raw', raw: JSON.stringify({ unidadeId: 1, canalPedido: 'APP', itens: [{ produtoId: 5, quantidade: 1 }] }) }",
              "}, (err, r) => { if (!err) pm.collectionVariables.set('pedidoRecusaId', r.json().id); });"
            ], "type": "text/javascript" } },
            { "listen": "test", "script": { "exec": [
              "pm.test('status 200', () => pm.response.code === 200);",
              "pm.test('pagamento RECUSADO', () => pm.expect(pm.response.json().statusPagamento).to.eql('RECUSADO'));"
            ], "type": "text/javascript" } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clienteToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/pagamentos", "host": ["{{baseUrl}}"], "path": ["api", "pagamentos"] },
            "body": { "mode": "raw", "raw": "{\n  \"pedidoId\": {{pedidoRecusaId}},\n  \"metodo\": \"MOCK\",\n  \"simular\": \"RECUSAR\"\n}" }
          }
        }
      ]
    }
  ]
}
